{
  "manifest_version": 2,
  "name": "Claude Subagent Inbox",
  "version": "1.1.0",
  "description": "Live inbox for subagent/tool output on claude.ai: watches subagents as they run, summarizes them, and lets you filter, pin, quote and jump to them.",
  "browser_specific_settings": { "gecko": { "id": "subagent-inbox@local" } },
  "permissions": ["storage", "https://claude.ai/*"],
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["content.js"],
    "css": ["inbox.css"],
    "run_at": "document_idle"
  }],
  "browser_action": { "default_title": "Toggle Subagent Inbox" },
  "background": { "scripts": ["background.js"] }
}
